+#ifdef STRATA_VOLTAFABRIC_POOL
+bool parse_vf_u64(const char* text, uint64_t& value) {
+    if (text == nullptr || text[0] == '\0') return false;
+    const char* end = text + std::strlen(text);
+    auto parsed = std::from_chars(text, end, value);
+    return parsed.ec == std::errc{} && parsed.ptr == end;
+}
+bool parse_vf_session_fds(const std::string& text, std::array<int, 48>& fds) {
+    size_t begin = 0;
+    for (size_t i = 0; i < fds.size(); ++i) {
+        size_t end = text.find(',', begin);
+        if (end == std::string::npos) end = text.size();
+        if (end == begin) return false;
+        int fd = -1;
+        auto parsed = std::from_chars(text.data() + begin, text.data() + end, fd);
+        if (parsed.ec != std::errc{} || parsed.ptr != text.data() + end || fd < 3) return false;
+        for (size_t prior = 0; prior < i; ++prior) if (fds[prior] == fd) return false;
+        fds[i] = fd;
+        begin = end + 1;
+        if (i + 1 < fds.size() && end == text.size()) return false;
+        if (i + 1 == fds.size() && end != text.size()) return false;
+    }
+    return true;
+}
+#endif
