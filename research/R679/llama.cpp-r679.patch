+// Opt-in host bridge for VoltaFabric's single-use Qwen2MoE routed-expert path.
+// The owner supplies the complete run/model/plan/batch identity in userdata.
+// abort() must be idempotent; a false append/finish result prevents host output.
+struct llm_vf_route_hooks {
+    void * userdata = nullptr;
+    bool (*begin)(void * userdata, const llama_ubatch & ubatch,
+                  llm_graph_type graph_type, uint32_t expected_layers) = nullptr;
+    ggml_tensor * (*append_qwen2moe)(void * userdata, ggml_context * ctx, int32_t layer,
+                                     ggml_tensor * activations, ggml_tensor * selected_experts,
+                                     ggml_tensor * final_weights, ggml_tensor * raw_expert_outputs) = nullptr;
+    bool (*finish)(void * userdata, bool ggml_success) = nullptr;
+    void (*abort)(void * userdata) = nullptr;
+};
